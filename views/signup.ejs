<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign up | ChitChat</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
    <div class="auth-card glass2">
        <div class="auth-logo">📚</div>
        <h1 class="auth-title">ChitChat</h1>
        <p class="auth-sub">Create your account to get started.</p>

        <form method="POST" action="/user/signup">
            <div>
                <div class="f-label">Full name</div>
                <input name="name" placeholder="Full Name" required>
            </div>
            <div>
                <div class="f-label">Email address</div>
                <input name="email" type="email" placeholder="you@example.com" required>
            </div>
            <div>
                <div class="f-label">Password</div>
                <input name="password" type="password" placeholder="Min 4 characters" required minlength="4">
            </div>
            <div class="err"><%= locals.error || '' %></div>
            <button class="btn">Create account</button>
        </form>

        <p class="auth-foot">Already have an account? <a class="link" href="/login">Log in</a></p>
    </div>
</body>
</html>
